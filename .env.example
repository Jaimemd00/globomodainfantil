# Copia este archivo a .env y ajusta los valores antes de desplegar.

# Puerto en el que escucha el servidor
PORT=3000

# Clave con la que se firman los tokens de sesión.
# OBLIGATORIO cambiarla en producción. Genera una así:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRA=7d

# Credenciales del administrador que crea "npm run seed"
ADMIN_EMAIL=admin@modaglobo.es
ADMIN_PASSWORD=admin1234

# Reglas de envío (euros)
ENVIO_ESTANDAR=4.95
ENVIO_GRATIS_DESDE=49

# Ruta del fichero SQLite (por defecto ./data/globo.db)
# DB_PATH=/var/lib/globo/globo.db

# ---------------------------------------------------------------------------
# Estudio de fotos (prueba virtual)
# ---------------------------------------------------------------------------
# simulacion : monta la prenda sobre la foto en el propio servidor. Sin coste,
#              sin salir a internet. Es el valor por defecto y sirve para
#              probar todo el circuito. NO es una prueba virtual real.
# fashn      : FASHN.ai        -> requiere FASHN_API_KEY
# fal        : fal.ai          -> requiere FAL_API_KEY
#
# ANTES de activar un proveedor real con fotos de menores:
#  1. Pide por escrito al proveedor que confirme que acepta imágenes de menores
#     con consentimiento parental para uso comercial. Guarda la respuesta.
#  2. Solicita retención cero y exclusión de entrenamiento sobre tus imágenes.
#  3. Asegúrate de que el consentimiento firmado por los padres menciona
#     expresamente el tratamiento con IA y el envío a un tercero.
TRYON_PROVEEDOR=simulacion
# FASHN_API_KEY=
# FAL_API_KEY=

# ---------------------------------------------------------------------------
# Pasarela de pago
# ---------------------------------------------------------------------------
# simulacion : página de pago falsa servida por la propia tienda. Sin claves,
#              sin internet y sin cobrar. Es el valor por defecto y sirve para
#              probar el circuito entero. NO cobra dinero real.
# stripe     : Stripe Checkout. La página de pago la aloja Stripe, así que los
#              datos de la tarjeta nunca pasan por este servidor.
PAGO_PROVEEDOR=simulacion

# Claves de Stripe. En modo de PRUEBAS empiezan por sk_test_ y no mueven dinero.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Métodos que se ofrecen en la pasarela, separados por comas.
# 'card' para tarjeta. Añade 'bizum' cuando lo tengas activado en el panel de
# Stripe (Configuración > Métodos de pago).
# STRIPE_METODOS=card

# URL pública de la tienda. Necesaria para que las URL de vuelta del pago
# apunten al dominio real y no a localhost.
# URL_PUBLICA=https://www.modaglobo.es
